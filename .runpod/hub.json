{
  "title": "vLLM Qwen3.5",
  "description": "vLLM serverless worker supporting Qwen3.5 and other latest models",
  "type": "serverless",
  "category": "language",
  "iconUrl": "https://registry.npmmirror.com/@lobehub/icons-static-png/latest/files/dark/vllm-color.png",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 150,
    "gpuCount": 1,
    "allowedCudaVersions": ["12.8", "12.7", "12.6", "12.5", "12.4", "12.3", "12.2", "12.1", "12.0"],
    "env": [
      {
        "key": "MODEL_NAME",
        "value": "Qwen/Qwen3.5-27B"
      },
      {
        "key": "MAX_MODEL_LEN",
        "value": "4096"
      },
      {
        "key": "GPU_MEMORY_UTILIZATION",
        "value": "0.92"
      },
      {
        "key": "TRUST_REMOTE_CODE",
        "value": "1"
      },
      {
        "key": "HF_TOKEN",
        "value": "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"
      },
      {
        "key": "DTYPE",
        "value": "auto"
      }
    ]
  }
}
