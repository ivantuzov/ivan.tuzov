{
  "title": "llama.cpp Qwen3.5-27B",
  "description": "llama.cpp serverless worker with Qwen3.5-27B abliterated GGUF",
  "type": "serverless",
  "category": "language",
  "config": {
    "runsOn": "GPU",
    "containerDiskInGb": 50,
    "gpuCount": 1,
    "allowedCudaVersions": ["12.8", "12.7", "12.6", "12.5", "12.4", "12.3", "12.2", "12.1"],
    "env": [
      {
        "key": "MODEL_REPO",
        "value": "mradermacher/Huihui-Qwen3.5-27B-abliterated-GGUF"
      },
      {
        "key": "MODEL_FILE",
        "value": "Huihui-Qwen3.5-27B-abliterated.Q4_K_M.gguf"
      },
      {
        "key": "CTX_SIZE",
        "value": "8192"
      },
      {
        "key": "GPU_LAYERS",
        "value": "99"
      }
    ]
  }
}
